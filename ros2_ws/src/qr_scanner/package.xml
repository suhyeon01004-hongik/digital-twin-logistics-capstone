<?xml version="1.0"?>
<package format="3">
  <name>qr_scanner</name>
  <version>0.1.0</version>
  <description>ROI-based QR scanner for ROS 2.</description>
  <maintainer email="suhyeon01004-hongik@users.noreply.github.com">Suhyeon Lee</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>libzbar0</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-pyzbar</exec_depend>
  <exec_depend>python3-qrcode</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
